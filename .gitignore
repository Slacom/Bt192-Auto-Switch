# GitHub uses an allow-list. Local archives remain available, but are not uploaded.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/文档/
!/构建脚本/
!/工具/

# Public docs: current work only; old docs contain device data and raw evidence links.
/文档/*
!/文档/016实测反馈_连接秒切回归与拖拽动画_修改计划.md
!/文档/GitHub上传与仓库整理说明.md

# Current source and the frozen015 negative-control input required by the tests.
/构建脚本/*
!/构建脚本/v3/
/构建脚本/v3/*
!/构建脚本/v3/v3_016/
!/构建脚本/v3/v3_015/
/构建脚本/v3/v3_015/*
!/构建脚本/v3/v3_015/V3DeviceScroll.smali

# MT helper plus the non-private limited-review narrative.
/工具/*
!/工具/mtmcp.py
!/工具/v3审查/
/工具/v3审查/*
!/工具/v3审查/v3_016/
/工具/v3审查/v3_016/*
!/工具/v3审查/v3_016/最终裁决/
/工具/v3审查/v3_016/最终裁决/*
!/工具/v3审查/v3_016/最终裁决/016独立逻辑槽位增量裁决.md

# Fail closed for generated binaries, local service sessions and signing secrets.
**/__pycache__/
*.py[cod]
*.apk
*.aab
*.dex
*.odex
*.vdex
*.oat
*.art
*.so
*.zip
*.7z
*.tar
*.gz
*.log
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
.env
.env.*
id_rsa
id_ed25519
**/session.json
**/build_result.json
**/build_input.json
**/candidate_identity.json
.DS_Store
.idea/
.vscode/
